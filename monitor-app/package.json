{
  "name": "monitor-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "docs": "typedoc --entryPointStrategy expand ./src --out dist/docs --name \"Manual Técnico - Monitor BI\"",
    "diagram": "madge --image dist/docs/diagrama_arquitectura.svg src/main.tsx",
    "build:all": "npm run build && npm run docs && npm run diagram",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "madge": "^8.0.0",
    "oxlint": "^1.81.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
